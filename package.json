{
  "name": "gb-gbc-gba-test-mcp",
  "version": "1.5.0",
  "description": "MCP server + headless harness to test Game Boy / Color / Advance games in EmulatorJS (mgba + gambatte): input, screenshots, save states, deterministic playback, RAM read/write/search, cheats and battery saves — no third-party emulator.",
  "keywords": ["mcp", "gba", "gb", "gbc", "gameboy", "emulator", "mgba", "gambatte", "emulatorjs", "testing", "ai", "game-testing", "homebrew", "rgbds", "gbdk", "devkitarm"],
  "license": "GPL-3.0-or-later",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/sandrinsol/gb-gbc-gba-test-mcp.git" },
  "bin": {
    "gb-gbc-gba-test-mcp": "harness/mcp-server.mjs"
  },
  "files": [
    "data/",
    "harness/*.mjs",
    "harness/page.html",
    "harness/package.json",
    "harness/README.md",
    "templates/",
    "NOTICE.md"
  ],
  "scripts": {
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "playwright": "^1.48.0",
    "zod": "^4.5.2"
  },
  "engines": {
    "node": ">=20"
  }
}
